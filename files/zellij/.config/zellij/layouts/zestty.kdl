layout {
    pane_template name="plain-pane" borderless=true
    default_tab_template {
        plain-pane size=1 {
            plugin location="zjstatus"
        }

        children
    }

    tab name="󰅩 Code" split_direction="vertical" {
        plain-pane {
            size "70%"
            command "nvim"
            args "-O2" "zestty" "src/main.rs" "README.md"
        }

        plain-pane command="bacon"
    }

    tab name=" Term" focus=true {
        plain-pane
    }

    tab name=" Git" {
        plain-pane command="lazygit"
    }
}
